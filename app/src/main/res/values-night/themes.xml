<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Pertemuan3_tia" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_soft</item>
        <item name="colorSecondary">@color/purple_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_lavender</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Font dari grand design -->
        <item name="android:fontFamily">@font/oswald_regular</item>
    </style>

    <style name="Theme.Pertemuan3_tia" parent="Base.Theme.Pertemuan3_tia" />

    <!-- Judul toolbar pakai font Barlow -->
    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/barlow_extrabold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/oswald_regular</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
